{
  "_note": "LLM providers and routing. Secrets come from environment variables only.",
  "providers": {
    "deepseek-main": {
      "kind": "anthropic",
      "base_url": "https://api.deepseek.com/anthropic",
      "api_key_env": "DEEPSEEK_MAIN_API_KEY",
      "credentials_ref": "deepseek-main",
      "models": [
        "deepseek-v4-flash"
      ],
      "priority": 20,
      "timeout": 120
    },
    "opencode-go": {
      "kind": "anthropic",
      "base_url": "https://opencode.ai/zen/go",
      "api_key_env": "OPENCODE_GO_API_KEY",
      "credentials_ref": "opencode-go",
      "models": [
        "GLM-5.3-Flash"
      ],
      "priority": 10,
      "timeout": 120,
      "pacing": {
        "min_interval": 5,
        "max_concurrency": 1
      }
    }
  },
  "default_provider": "opencode-go",
  "routing": {
    "scenario": {
      "chapter-draft": {
        "provider": "opencode-go",
        "thinking": "medium"
      },
      "chapter-polish": {
        "provider": "opencode-go",
        "thinking": "high"
      },
      "summary": {
        "provider": "opencode-go",
        "thinking": "low"
      },
      "review": {
        "provider": "opencode-go",
        "thinking": "high"
      }
    },
    "book": {},
    "chapter": {}
  },
  "thinking_levels": [
    "off",
    "low",
    "medium",
    "high"
  ]
}
