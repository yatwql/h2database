{
  "_note": "LLM providers and routing. Secrets come from environment variables only.",
  "providers": {
    "mock": {
      "kind": "mock",
      "description": "Offline provider used by tests and dry runs."
    },
    "openai": {
      "kind": "openai-compatible",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "models": [
        "gpt-4o-mini"
      ]
    },
    "deepseek": {
      "kind": "openai-compatible",
      "base_url": "https://api.deepseek.com/v1",
      "api_key_env": "DEEPSEEK_API_KEY",
      "models": [
        "deepseek-chat"
      ]
    },
    "kimi-main": {
      "kind": "anthropic",
      "base_url": "https://api.moonshot.cn/anthropic",
      "api_key_env": "KIMI_MAIN_API_KEY",
      "credentials_ref": "kimi-main",
      "models": [
        "kimi-k2.6"
      ],
      "priority": 50,
      "timeout": 120
    },
    "deepseek-main": {
      "kind": "anthropic",
      "base_url": "https://api.deepseek.com/anthropic",
      "api_key_env": "DEEPSEEK_MAIN_API_KEY",
      "credentials_ref": "deepseek-main",
      "models": [
        "deepseek-v4-flash"
      ],
      "priority": 10,
      "timeout": 120
    },
    "opencode-go": {
      "kind": "anthropic",
      "base_url": "https://opencode.ai/zen/go",
      "api_key_env": "OPENCODE_GO_API_KEY",
      "credentials_ref": "opencode-go",
      "models": [
        "GLM-5.3-Flash"
      ],
      "priority": 20,
      "timeout": 120,
      "pacing": {
        "min_interval": 5,
        "max_concurrency": 1
      }
    },
    "kimi-code": {
      "kind": "anthropic",
      "base_url": "https://api.kimi.com/coding",
      "api_key_env": "KIMI_CODE_API_KEY",
      "credentials_ref": "kimi-code",
      "models": [
        "kimi-for-coding"
      ],
      "priority": 50,
      "timeout": 120
    }
  },
  "default_provider": "mock",
  "routing": {
    "scenario": {
      "chapter-draft": {
        "provider": "mock",
        "thinking": "medium"
      },
      "chapter-polish": {
        "provider": "mock",
        "thinking": "high"
      },
      "summary": {
        "provider": "mock",
        "thinking": "low"
      },
      "review": {
        "provider": "mock",
        "thinking": "high"
      }
    },
    "book": {},
    "chapter": {}
  },
  "thinking_levels": [
    "off",
    "low",
    "medium",
    "high"
  ]
}
