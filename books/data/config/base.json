{
  "_note": "Infrastructure: where the source tree lives, where state/baselines go, toolchain budgets.",
  "paths": {
    "snapshots": "data/snapshots"
  },
  "sources": {
    "file_suffix": ".java",
    "package_prefix": "org.h2",
    "language": "java",
    "languages": [
      "java"
    ],
    "suffixes": {
      "java": ".java",
      "python": ".py",
      "rust": ".rs",
      "kotlin": ".kt",
      "go": ".go",
      "c": ".c"
    }
  },
  "baselines": {
    "ascii": "data/baselines/diagrams.json",
    "captions": "data/baselines/captions.json",
    "content_depth": "data/baselines/content-depth.json",
    "content_volume": "data/baselines/content-volume.json",
    "coverage": "data/baselines/coverage.json",
    "editorial": "data/baselines/editorial.json",
    "perf": "data/baselines/perf.json",
    "readability_box": "data/baselines/readability.json",
    "source_symbol": "data/baselines/source-symbols.json",
    "style_rules": "data/baselines/style-rules.json"
  },
  "toolchain": {
    "coverage_fail_under": 90,
    "pdf_max_mb": 12,
    "epub_max_mb": 10,
    "ascii_max_cols": 100,
    "pdf_page_width": 595,
    "pdf_page_height": 842,
    "pdf_page_tolerance": 2,
    "content_floor_ratio": 0.95,
    "pdf_page_ratio": 0.9,
    "epub_size_ratio": 0.85,
    "content_profile": "baseline",
    "step_timeout_s": 900,
    "test_timeout_s": 300,
    "coverage_min_per_file": 90,
    "function_length_warn": 60,
    "pdf_split_by_chapter": true,
    "pdf_bytes_per_page": 30000.0,
    "layout_spacing_scale": 0.7,
    "layout_print_adaptive": true,
    "layout_print_chars_per_line": 22,
    "layout_print_code_lead_target": 0.1,
    "balance_max_min_ratio": 3.0,
    "optional_imports": [
      "fontTools"
    ],
    "book_vocabulary": [
      "MVStore",
      "TransactionStore",
      "JdbcStatement",
      "SessionLocal",
      "H2 Console",
      "H2 source",
      "H2 数据库引擎"
    ]
  },
  "logging": {
    "level": "INFO",
    "dir": "logs",
    "retention_days": 14
  },
  "archive": {
    "dir": "data/archive",
    "retention_days": 45
  },
  "reports": {
    "dir": "test-reports",
    "retention_days": 30
  }
}
