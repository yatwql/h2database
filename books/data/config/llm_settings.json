{
  "_note": "Per-scenario generation settings; routing (which provider) lives in llm_provider.json. daily_cost_limit: daily spend ceiling in the pricing currency (0 disables the warning).",
  "daily_cost_limit": 0,
  "defaults": {
    "temperature": 0.3,
    "max_tokens": 2048,
    "timeout_s": 60,
    "retries": 1,
    "thinking": "low"
  },
  "scenarios": {
    "chapter-draft": {
      "temperature": 0.4,
      "max_tokens": 4096
    },
    "chapter-polish": {
      "temperature": 0.2,
      "max_tokens": 3072
    },
    "summary": {
      "temperature": 0.1,
      "max_tokens": 800
    },
    "review": {
      "temperature": 0.0,
      "max_tokens": 1200
    }
  },
  "books": {},
  "chapters": {},
  "policy": {
    "note": "LLM is only allowed for prose generation/review; facts, structure and metrics stay deterministic.",
    "llm_scenarios": [
      "chapter-draft",
      "chapter-polish",
      "summary",
      "review"
    ],
    "deterministic": [
      "structure",
      "coordinates",
      "crossrefs",
      "links",
      "duplicates",
      "prose-metrics",
      "captions",
      "index",
      "glossary",
      "tables"
    ]
  }
}
