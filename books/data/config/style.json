{
  "_note": "Book style: display copy, section skeleton, caption vocabulary, writing thresholds, generation templates.",
  "project": {},
  "sections": {
    "per_chapter": []
  },
  "captions": {
    "leading_verbs": [
      "展示",
      "对比",
      "拆解",
      "演示",
      "标注",
      "概览",
      "追踪",
      "描绘",
      "刻画",
      "归纳",
      "罗列",
      "列出",
      "勾勒",
      "呈现",
      "串联",
      "说明",
      "揭示",
      "体现",
      "反映",
      "阐释",
      "解读",
      "剖析",
      "梳理",
      "汇总",
      "汇集",
      "记录"
    ],
    "vague_trailing": [
      "过程",
      "示例",
      "架构",
      "图",
      "机制",
      "流程"
    ],
    "presets": {
      "strict": {
        "min_chars": 8,
        "max_chars": 30,
        "fail_at": 0
      },
      "normal": {
        "min_chars": 6,
        "max_chars": 35,
        "fail_at": 30
      },
      "loose": {
        "min_chars": 4,
        "max_chars": 45,
        "fail_at": 80
      }
    }
  },
  "diagrams": {
    "markers": [
      "┌",
      "└",
      "├",
      "│",
      "▼",
      "▲",
      "→"
    ]
  },
  "quality": {
    "max_duplicate_ratio": 12,
    "max_avg_sentence": 45,
    "max_long_lines": 40,
    "min_coords_per_chapter": 15,
    "min_chapter_lines": 150,
    "max_chapter_lines": 450,
    "max_table_rows": 20,
    "min_terms_per_chapter": 5,
    "min_exercises_per_chapter": 4,
    "_duplicate_ratio_note": "Single-owner chapter scopes brought prose duplication to ~4%; the gate is kept at 12% so a regression is caught without blocking legitimate overlap."
  },
  "generation": {
    "max_packages_per_table": 12,
    "max_classes_per_package": 4,
    "max_api_rows": 20,
    "exercises_per_chapter": 4,
    "checklist_items": 5,
    "templates": {
      "map_intro": "第{num}章覆盖 {pkgs} 个包（{sig}）、{lines} 行实现；规模第一的是 `{top}`（{toplines} 行）。",
      "types_intro": "在 `{top}` 之外，本章还有 {others} 个包；下表每包取前 {take} 个类型，按规模降序。",
      "api_intro": "把 {pkgcount} 个包的关键入口与源码位置对应起来，共 {rows} 条坐标，行号由脚本核验。",
      "path_intro": "读 `{top}` 的 {files} 个文件时，先看骨架类，再沿 `{dep}` 方向下钻。",
      "deep_dive": [
        "规模信号：`{top}` 占本章 {share}% 的实现行数，改动风险最高。",
        "耦合信号：`{top}` 依赖 {deps} 个 `org.h2` 包，其中 `{dep}` 出现最频繁。",
        "入口信号：`{big}` 的公开方法 {methods} 个，读它等于读本章的主干。"
      ]
    }
  },
  "thresholds": {
    "exercises_min_per_chapter": 3,
    "exercises_min_total": 50,
    "index_main_min": 150,
    "index_sub_min": 50,
    "index_see_also_min": 30,
    "glossary_min_entries": 60,
    "chapters_min_cross_refs": 1
  },
  "prose": {
    "avg_sentence_good": 28,
    "avg_sentence_bad": 45,
    "long_ratio_good": 8,
    "long_ratio_bad": 30,
    "paragraph_good_min": 80,
    "paragraph_good_max": 420,
    "bullet_good": 12,
    "bullet_bad": 60,
    "coords_good": 20,
    "coords_bad": 4,
    "h3_good": 6,
    "h3_bad": 0,
    "dup_good": 5,
    "dup_bad": 20,
    "table_good": 0,
    "table_bad": 20,
    "min_composite": 80
  }
}
