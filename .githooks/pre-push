#!/usr/bin/env bash
# P1 gate before a push: every quality gate + unit suite.
#
# Installed by books/scripts/install-hooks.sh. Bypass with: git push --no-verify
# The tier list is shared with CI (books/src/python/check_runner.py --mode p1).
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUNNER="$REPO_ROOT/books/src/python/check_runner.py"
PYTHON="${PYTHON:-$REPO_ROOT/books/.venv/bin/python}"
[ -x "$PYTHON" ] || PYTHON="$(command -v python3)"
[ -f "$RUNNER" ] || { echo "pre-push: runner not found, skipping" >&2; exit 0; }

echo "pre-push: P1 tier (full gates) …"
exec "$PYTHON" "$RUNNER" --mode p1
